{
	"name": "lesomnus/usersync",
	"dockerComposeFile": "docker-compose.yaml",
	"service": "dev",
	"workspaceFolder": "/workspace",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go",
				"hashicorp.hcl",
				"streetsidesoftware.code-spell-checker"
			]
		}
	}
}
